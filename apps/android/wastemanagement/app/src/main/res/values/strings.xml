    <string name="landing_features_badge">FITUR UTAMA</string>
    <string name="landing_features_title">Kemudahan Untuk Pengelola</string>
    <string name="landing_features_desc">Tampilan besar, jelas, dan mudah digunakan oleh semua kalangan umur.</string>
    
    <string name="landing_features_warga_title">Data Warga</string>
    <string name="landing_features_warga_desc">Menambah, mencari, dan mengelola data warga anggota penyetor sampah dengan cepat dan mudah.</string>
    <string name="landing_features_transaksi_title">Catat Transaksi</string>
    <string name="landing_features_transaksi_desc">Pilih warga, pilih jenis sampah, masukkan berat. Sistem menghitung total harga otomatis!</string>
    <string name="landing_features_grafik_title">Laporan &amp; Grafik</string>
    <string name="landing_features_grafik_desc">Pantau total sampah terkumpul dan uang keluar setiap bulan lewat grafik yang jelas.</string>

    <string name="landing_categories_badge">KATEGORI SAMPAH</string>
    <string name="landing_categories_title">Jenis Sampah yang Diterima</string>
    <string name="landing_categories_desc">Pilahlah sampah Anda sebelum disetorkan ke Bank Sampah untuk mempermudah pemrosesan.</string>

    <string name="landing_cat_organik_title">Organik</string>
    <string name="landing_cat_organik_desc">Sampah yang berasal dari sisa makhluk hidup dan dapat terurai alami. Diolah menjadi kompos bernilai guna.</string>
    <string name="landing_cat_organik_examples">Contoh: Sisa sayuran, kulit buah, daun kering, cangkang telur, dll.</string>
    <string name="landing_cat_organik_tips">Tips: Pisahkan dari plastik pembungkus sebelum dibuang.</string>

    <string name="landing_cat_nonorganik_title">Non-Organik</string>
    <string name="landing_cat_nonorganik_desc">Sampah yang tidak mudah terurai alami namun dapat didaur ulang dan memiliki nilai jual ekonomi tinggi.</string>
    <string name="landing_cat_nonorganik_examples">Contoh: Botol plastik, koran, kardus, kaleng logam, botol kaca, dll.</string>
    <string name="landing_cat_nonorganik_tips">Tips: Bersihkan dan keringkan sebelum disetor agar bernilai tinggi.</string>

    <string name="landing_cat_b3_title">B3 (Berbahaya &amp; Beracun)</string>
    <string name="landing_cat_b3_desc">Sampah dari bahan berbahaya atau beracun yang memerlukan penanganan khusus agar tidak mencemari lingkungan.</string>
    <string name="landing_cat_b3_examples">Contoh: Baterai bekas, bohlam lampu, kemasan obat-obatan, botol aerosol, dll.</string>
    <string name="landing_cat_b3_tips">Tips: Kumpulkan di wadah khusus yang aman dan jauh dari anak-anak.</string>
