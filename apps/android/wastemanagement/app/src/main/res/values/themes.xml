<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Material3, sesuai dengan green palette website -->
    <style name="Base.Theme.Wastemanagement" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_700</item>
        <item name="colorPrimaryDark">@color/green_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/emerald_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/gray_900</item>
        <item name="colorError">@color/red_600</item>
        <item name="android:windowBackground">@color/background_secondary</item>
        <item name="android:statusBarColor">@color/green_800</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Theme.Wastemanagement" parent="Base.Theme.Wastemanagement" />

    <!-- Landing Page Theme — Fullscreen dark green -->
    <style name="Theme.Wastemanagement.Landing" parent="Base.Theme.Wastemanagement">
        <item name="android:windowBackground">@color/green_950</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/green_950</item>
    </style>

    <!-- Login Page Theme -->
    <style name="Theme.Wastemanagement.Login" parent="Base.Theme.Wastemanagement">
        <item name="android:windowBackground">@color/gray_50</item>
        <item name="android:statusBarColor">@color/gray_50</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Custom Input Style — Sesuai design website -->
    <style name="Widget.Wastemanagement.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/green_600</item>
        <item name="hintTextColor">@color/green_700</item>
    </style>
</resources>