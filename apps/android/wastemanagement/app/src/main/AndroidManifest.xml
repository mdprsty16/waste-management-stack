<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission untuk API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_bssb"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_bssb"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wastemanagement"
        android:usesCleartextTraffic="true">

        <!-- Landing Page — LAUNCHER -->
        <activity
            android:name=".ui.landing.LandingActivity"
            android:exported="true"
            android:theme="@style/Theme.Wastemanagement.Landing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Page -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Wastemanagement.Login" />

        <!-- Dashboard Page -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.Wastemanagement" />

        <!-- Original MainActivity — backup, not launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
    </application>

</manifest>