// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id_admin   String      @id @default(uuid())
  username   String      @unique @db.VarChar(50)
  password   String      @db.VarChar(255)
  nama_admin String      @db.VarChar(100)
  created_at DateTime    @default(now()) @db.Timestamp(0)
  transaksi  Transaksi[]

  @@map("admin")
}

model Nasabah {
  id_nasabah String      @id @default(uuid())
  // Opsional: kode unik agar mudah dibedakan di dropdown jika nama sama
  kode_nasabah String?   @unique @db.VarChar(20) 
  nama       String      @db.VarChar(255)
  nomor_hp   String?     @unique @db.VarChar(20) // Tambahan untuk pembeda di dropdown
  rt         String?     @db.VarChar(10)
  rw         String?     @db.VarChar(10)
  is_active  Boolean     @default(true) // Untuk soft delete
  created_at DateTime    @default(now()) @db.Timestamp(0)
  transaksi  Transaksi[]

  @@index([nama]) // Indexing untuk mempercepat pencarian autocomplete
  @@map("nasabah")
}

model JenisSampah {
  id_jenis_sampah   String   @id @default(uuid())
  nama_jenis        String   @unique @db.VarChar(100) // Jadikan unique agar tidak ada duplikasi jenis
  densitas_kg_per_m3 Float    @db.Float
  harga_per_kg      Float    @db.Float
  kategori          String   @db.VarChar(50)
  is_active         Boolean  @default(true) // Jika jenis sampah ini sudah tidak diterima lagi
  created_at        DateTime @default(now()) @db.Timestamp(0)
  detail_transaksi  DetailTransaksi[]

  @@index([nama_jenis]) // Indexing untuk pencarian autocomplete
  @@map("jenis_sampah")
}

model Transaksi {
  id_transaksi    String   @id @default(uuid())
  id_nasabah      String
  id_admin        String?  // Relasi ke siapa yang input data ini
  tanggal         DateTime @db.Date
  total_berat_kg  Float    @db.Float
  total_volume_m3 Float    @db.Float
  total_harga     Float    @db.Float
  created_at      DateTime @default(now()) @db.Timestamp(0)
  
  nasabah         Nasabah  @relation(fields: [id_nasabah], references: [id_nasabah], onDelete: Cascade)
  admin           Admin?   @relation(fields: [id_admin], references: [id_admin], onDelete: SetNull)
  detail_transaksi DetailTransaksi[]

  @@index([id_nasabah])
  @@index([id_admin])
  @@map("transaksi")
}

model DetailTransaksi {
  id_detail       String      @id @default(uuid())
  id_transaksi    String
  id_jenis_sampah String
  berat_kg        Float       @db.Float
  volume_m3       Float       @db.Float
  subtotal_harga  Float       @db.Float
  
  transaksi       Transaksi   @relation(fields: [id_transaksi], references: [id_transaksi], onDelete: Cascade)
  jenis_sampah    JenisSampah @relation(fields: [id_jenis_sampah], references: [id_jenis_sampah], onDelete: Restrict)

  @@index([id_transaksi])
  @@index([id_jenis_sampah])
  @@map("detail_transaksi")
}